// Project-local debug tasks
//
// For more documentation on how to configure debug tasks,
// see: https://zed.dev/docs/debugger
[
  {
    "adapter": "CodeLLDB",
    "label": "Server",
    "build": {
      "label": "cargo run -p hazel-server",
      "command": "cargo",
      "args": ["build", "--package", "hazel-server"],
      "cwd": "$ZED_WORKTREE_ROOT/crates/simulation",
      "use_new_terminal": false,
      "allow_concurrent_runs": false,
      "reveal": "always",
      "reveal_target": "dock",
      "hide": "never",
      "shell": "system",
      "show_summary": false,
      "show_command": false,
      "save": "none",
      "hooks": [],
    },
    "sourceLanguages": ["rust"],
  },
  {
    "adapter": "CodeLLDB",
    "label": "SIMULATION: Screencast from file",
    "request": "launch",
    "build": {
      "label": "cargo run -p hazel-server",
      "command": "cargo",
      "args": ["build", "--package", "simulation"],
      "cwd": "$ZED_WORKTREE_ROOT/crates/simulation",
      "use_new_terminal": false,
      "allow_concurrent_runs": false,
      "reveal": "always",
      "reveal_target": "dock",
      "hide": "never",
      "shell": "system",
      "show_summary": false,
      "show_command": false,
      "save": "none",
      "hooks": [],
    },
    "program": "$ZED_WORKTREE_ROOT/target/debug/simulation",
    "args": [
      "screen-cast",
      "--mode", "file",
      "--file", "/home/tapo4eg3d/Downloads/test.mov",
    ],
    "sourceLanguages": ["rust"],
  },
]
